# 历史说 · 出片工具 密钥模板
# 首次使用：复制本文件为 .env，然后填下面的密钥
#   cp .env.example .env
# ⚠ .env 含密钥，已被 git 忽略，不会上传到 GitHub；谁用谁注册，各填各的

# ── AI 生图（历史说主流程）────────────────────────────
# 阿里云百炼 DashScope：wanx 生图 + happyhorse 图生视频
# 注册：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# ── AI 写稿 / 提示词 ──────────────────────────────────
# DeepSeek：写稿、生图提示词、情绪标注
# 注册：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── AI 视频（白酒短剧流程）────────────────────────────
# 智谱 CogVideoX：文生视频（免费 flash / 付费 cogvideox-3）
# 注册：https://open.bigmodel.cn
ZHIPU_API_KEY=

# ── 语音配音（对话式/旁白）────────────────────────────
# 豆包语音（火山引擎 seed-tts）：多角色自然配音
# 注册：https://console.volcengine.com（开通「语音合成」）
DOUBAO_TTS_KEY=

# ── 豆包大模型（可选，备用）───────────────────────────
# 火山方舟 ARK：豆包大模型
# 注册：https://console.volcengine.com/ark
ARK_API_KEY=

# ── 视频/图片素材抓取（可选，视频模式用）──────────────
# Pexels：抓取无版权视频/图片素材
# 注册：https://www.pexels.com/api
PEXELS_API_KEY=
